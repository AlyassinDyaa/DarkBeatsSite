# Every setting the site's functions read. Put the real values in the Vercel project
# (Settings → Environment Variables), and redeploy. To try things on this computer, copy this
# file to .env.local (never committed) and fill it in. Never put real values in this file.

# ---- Admin login (already set) ----
ADMIN_PASSCODE=
GITHUB_TOKEN=

# ---- Payments ----
# Stripe: Dashboard → Developers → API keys (sk_test_... while testing, sk_live_... when real)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → endpoint https://<site>/api/stripe-webhook (whsec_...)
STRIPE_WEBHOOK_SECRET=
# PayPal: developer.paypal.com → Apps & Credentials (Sandbox while testing)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# leave empty while testing (PayPal sandbox); "live" once the keys are real ones
PAYPAL_MODE=

# ---- Customer accounts (MongoDB) ----
# MongoDB Atlas → Connect → Drivers: mongodb+srv://<user>:<password>@<cluster>/...
MONGODB_URI=
# optional; "jbeatsart" when empty
MONGODB_DB=

# ---- Emails (password reset, confirm your email) ----
# resend.com → API Keys
RESEND_API_KEY=
# a sender on a domain verified in Resend, for example: JBeatsArt <hello@jbeatsart.com>
MAIL_FROM=
# optional: the name at the top of the emails (JBeatsArt when empty)
MAIL_BRAND=

# ---- The site's address, for links in emails ----
# for example https://jbeatsart.vercel.app (or your own domain once it has one)
SITE_URL=
