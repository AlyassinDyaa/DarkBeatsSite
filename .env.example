# Every setting the site's functions read. Put the real values in the Vercel project
# (Settings → Environment Variables), and redeploy. To try things on this computer, copy this
# file to .env.local (never committed) and fill it in. Never put real values in this file.

# ---- Admin login (already set) ----
ADMIN_PASSCODE=
GITHUB_TOKEN=

# ---- Payments ----
# Stripe: Dashboard → Developers → API keys (sk_test_... while testing, sk_live_... when real)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → endpoint https://<site>/api/stripe-webhook, events
# checkout.session.completed, checkout.session.async_payment_succeeded, charge.refunded (whsec_...)
STRIPE_WEBHOOK_SECRET=
# PayPal: developer.paypal.com → Apps & Credentials (Sandbox while testing)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# leave empty while testing (PayPal sandbox); "live" once the keys are real ones
PAYPAL_MODE=

# ---- Customer accounts (MongoDB) ----
# MongoDB Atlas → Connect → Drivers: mongodb+srv://<user>:<password>@<cluster>/...
MONGODB_URI=
# optional; "jbeatsart" when empty
MONGODB_DB=

# ---- Emails (confirm your email, reset your password, Contact and Commission messages) ----
# Either an email account's sending server (SMTP), e.g. Gmail with an app password
# (Google Account → Security → 2-Step Verification → App passwords):
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# or Resend (resend.com → API Keys), sending from a domain verified there:
RESEND_API_KEY=
# a sender on a domain verified in Resend, for example: JBeatsArt <hello@jbeatsart.com>
MAIL_FROM=
# optional: the name at the top of the emails (JBeatsArt when empty)
MAIL_BRAND=
# optional: where replies to these emails go
MAIL_REPLY_TO=
# optional: where Contact and Commission messages go (the email in Site → Brand & contact when empty)
CONTACT_TO=
# optional: where the "new order" emails go (CONTACT_TO, then the email in Site → Brand & contact, when empty)
ORDER_EMAIL_TO=

# ---- The site's address, for links in emails ----
# for example https://jbeatsart.vercel.app (or your own domain once it has one)
SITE_URL=
